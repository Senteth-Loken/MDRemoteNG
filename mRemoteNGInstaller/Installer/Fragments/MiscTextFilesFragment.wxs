<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <ComponentGroup Id="CG.ProjectInfoFiles" Directory="INSTALLDIR">
      <Component Id="C.Changelog" Guid="*">
        <File Id="ChangelogFile" Name="Changelog" Source="$(var.InstallerSolutionDir)CHANGELOG.md" KeyPath="yes" />
      </Component>
      <Component Id="C.License" Guid="*">
        <File Id="LicenseFile" Name="License" Source="$(var.InstallerSolutionDir)COPYING.TXT" KeyPath="yes" />
      </Component>
      <Component Id="C.Readme" Guid="*">
        <File Id="ReadmeFile" Name="Readme" Source="$(var.InstallerSolutionDir)README.md" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
