<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MDRemoteNG.Discovery</AssemblyName>
    <RootNamespace>MDRemoteNG.Discovery</RootNamespace>
    <Platforms>AnyCPU;x64;arm64</Platforms>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release Self-Contained'">
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-$(Platform)</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MDRemoteNG.Core\MDRemoteNG.Core.csproj" />
    <ProjectReference Include="..\MDRemoteNG.Desktop\MDRemoteNG.Desktop.csproj" />
    <None Update="Configure-Discovery.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
